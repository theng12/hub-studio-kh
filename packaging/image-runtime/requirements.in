# FastAPI's `Form`/`File` parameters need python-multipart at import time, and the Image
# worker gained them with the Reference-to-Image route (`POST /api/generate/edit`). Without it
# `create_app` raises inside route registration, so the packaged worker never starts. The test
# environment already had it; the packaged runtime did not until 0.6.202.
python-multipart==0.0.32
