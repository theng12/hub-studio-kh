  "note": "Frozen acceptance cases plus concrete operation vectors. These are not execution proof; app tests compile/run them after the382 gate exits.",
  "fixtures": [
    {
      "id": "LL-F01",
      "target": "electron/server/__tests__/final-render-export.test.ts",
      "name": "capability absent refuses loudly",
      "setup": "opts with 1 image-backed cue; discovery record without late_labels",
      "expect": "describeFinalRenderExport -> { kind: 'local-only', reason: 'contextual_cues' }; no operations, no cue assets"
    },
    {
      "id": "LL-F02",
      "target": "electron/server/__tests__/final-render-export.test.ts",
      "name": "capability present exports stage in decided order",
      "setup": "discovery.late_labels = { format, motions:[all] }; 2 image cues (one pop still, one wipe)",
      "expect": "exportable; each op kind 'late_label_stage' with contract id; array order has every late op after 'presentation_frame' op and before 'logo' op; source_requirements carry role 'cue_label' bound 1:1 to op asset_refs (bijection)"
    },
    {
      "id": "LL-F03",
      "target": "electron/server/__tests__/final-render-export.test.ts",
      "name": "legacy drawtext templates -> distinct loud refusal",
      "setup": "cues with template documentary-label / map-pin / archival-caption / chapter-plate, capability present",
      "expect": "reason 'contextual_cues_drawtext' (distinct from 'contextual_cues'); never exportable, never partially staged — named gap, loud local"
    },
    {
      "id": "LL-F04",
      "target": "electron/server/__tests__/final-render-export.test.ts",
      "name": "unknown template id refuses, no partial coverage",
      "setup": "cue.template not in {label:*} and not one of the four legacy ids; capability present",
      "expect": "local-only with its own named reason; zero cue ops in any result"
    },
    {
      "id": "LL-F05",
      "target": "electron/server/__tests__/final-render-recipe.test.ts",
      "name": "stage order + exact fields + repeatability",
      "setup": "valid recipe variants",
      "expect": "late op before presentation_frame -> 'stage order is invalid'; between frame and logo -> accepted; unknown extra field in op -> exact() rejection; two cue ops accepted (singleton exemption) while 'logo' twice still rejected; enable.end_sec > target_duration_sec -> rejected"
    },
    {
      "id": "LL-F06",
      "target": "electron/server/__tests__/final-render-recipe.test.ts",
      "name": "ref-role bijection for cue assets",
      "setup": "op asset_ref pointing at a manifest entry with role 'overlay'; and inverse: cue_label entry with no referencing op",
      "expect": "both invalid; matching role cue_label + reference -> valid"
    },
    {
      "id": "LL-F07",
      "target": "electron/server/__tests__/final-render-recipe.test.ts",
      "name": "safe_name bound for long cue ids",
      "setup": "generated stem from a 63-char cue_id exceeding 64 chars without truncation rule; and the truncated+8hex form",
      "expect": "untruncated name rejected by SAFE_NAME; deterministic truncated form (<=64, unique) accepted"
    },
    {
      "id": "LL-F08",
      "target": "electron/server/__tests__/final-render-recipe.test.ts",
      "name": "reveal frame list exact arithmetic",
      "setup": "working_fps 25, duration_sec 0.3 -> L must be max(2, ceil(25*0.3)+1) = 9; variants with L=8, L=10, progress jumps, non-ordered progress",
      "expect": "9 accepted; 8/10 rejected; progress must equal i/(L-1) ascending; wrong count rejected by name"
    },
    {
      "id": "LL-F09",
      "target": "electron/server/__tests__/final-render-compiler.test.ts",
      "name": "compiler emits every motion + primary clock/EOF",
      "setup": "one packet per motion kind: none, pop, slide, float, pulse, wipe, line-draw (+pointing line, +line without reveal)",
      "expect": "eof_action=repeat; primary video controls EOF. Pop/pulse loop at working_fps and retain local shortest=1 (shortest input is primary video; cue is infinite). Finite PNG sequences and static/offset-only inputs must NOT use shortest=1, so reveal EOF never truncates primary. Final output remains bounded by target duration. Receiver creates a private trusted image2 sequence by copying/linking the explicitly ordered validated PNG refs to locally generated contiguous filenames; only receiver-generated paths/pattern are passed to FFmpeg. Sender never supplies pattern/path. Input framerate=working_fps; frame i PTS=i/working_fps+enable.start_sec, so final frame begins at (L-1)/fps (may exceed0.3 at nonintegral fps*0.3). Preserve this local discrete timing; do not resample or stretch. contextualCueCount must be nonzero."
    },
    {
      "id": "LL-F10",
      "target": "electron/server/__tests__/label-motion.test.ts",
      "name": "real-binary acceptance across all motions (Hub-requested)",
      "setup": "drive the exact compiled filter strings for all six motion kinds + no-motion through FFmpeg on a short primary clip",
      "expect": "graph starts (no init-eval frame-variable refusal), completes, holds reveal last frame to EOF, output duration equals input (no shortest hang)"
    },
    {
      "id": "LL-F11",
      "target": "electron/server/__tests__/private-render-owner-admission.test.ts",
      "name": "limits refuse pre-accept naming the published figure",
      "setup": "cue set whose assets exceed the discovery-published max_assets / max_total_input_bytes (values injected from a stubbed capabilities record)",
      "expect": "preparePrivateFinalRenderDescriptor returns null; output_lines sentence names the exact published figure and says the video stays local; no intent staged"
    },
    {
      "id": "LL-F12",
      "target": "electron/server/__tests__/private-render-owner-admission.test.ts",
      "name": "pinned lineage overrides pre-accept fallback",
      "setup": "known staged intent present + capability absent (or limits breach)",
      "expect": "throws 'Existing private final render lineage requires recovery before local rendering' — reconcile pinned node/key before local; never a quiet local render"
    },
    {
      "id": "LL-F13",
      "target": "electron/server/__tests__/label-design-render.test.ts",
      "name": "PNG encoding facts",
      "setup": "renderLabelDesign still; wipe frame 0 and frame L-1; line still; line frame L-1",
      "expect": "all 8-bit RGBA non-interlaced (color type 6); wipe frames share the still's exact WxH; frame 0 fully transparent; frame L-1 content identical to still; line frames full canvas WxH"
    },
    {
      "id": "LL-F14",
      "target": "electron/server/__tests__/private-render-client.test.ts",
      "name": "capability record parse closed",
      "setup": "late_labels present with exact fields; with an unknown extra field; malformed motions list",
      "expect": "Exact scoped record accepted; unknown fields/malformed motions/unsolicited record fail closed as discovery validation error; no intent staged and loud local unless known lineage demands reconciliation."
    }
  ],
