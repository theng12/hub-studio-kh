.DS_Store
.build/
dist/
/.release-dist.lock
.venv/
__pycache__/
*.pyc
.pytest_cache/
.superpowers/

# Stocked model assets; keep external to source and app bundles.
/model-library/

.worktrees/

# Hub runtime state must never be committed
components/.hub_token
components/hub.db
components/.fleet_token
components/.kh_studio_token
.kh_studio_token
# The per-node credential a controller issued this Mac. A secret like the two above, and it was
# missing from this list: the suite writes one into the checkout whenever a test joins a Hub
# without redirecting `fleet_nodes.NODE_CREDENTIAL_FILE`, so `git add -A` could commit it.
components/.node_credential
# Left by a run: the Hub's own runtime archive and its startup audit trail.
components/startup_audit.jsonl
components/trash/

# Written by the Hub at runtime; the role tests redirect it, but a manual run must not commit it.
/components/controller_settings.json
/components/controller_settings.json.repair.lock

# The graphify knowledge graph is a local index, rebuilt from the tree.
/graphify-out/

# Recoverable "delete". The owner sorts this folder; it is never committed.
_trash/
